{
    "name": "ayurviro/public-care-ayurveda",
    "description": "Ayurviro Ayurvedic Healthcare Platform",
    "type": "project",
    "require": {
        "php": ">=8.1",
        "phpmailer/phpmailer": "6.9",
        "dompdf/dompdf": "3.0",
        "mpdf/mpdf": "^8.3"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "exclude-from-classmap": ["tests/"]
    },
    "scripts": {
        "test": "phpunit -c tests/phpunit.xml",
        "test:unit": "phpunit -c tests/phpunit.xml --testsuite unit",
        "test:integration": "phpunit -c tests/phpunit.xml --testsuite integration"
    }
}
